# Documentation only. The installer creates /etc/vohive/config.yaml with a
# fresh random initial password and mode 0600. Never copy this example without
# replacing the password with a strong, unique secret.
config_schema: 1
server:
  port: 7575
  debug: false
web:
  username: admin
  password: replace-with-a-strong-random-secret
free_device_limit: 5
vowifi:
  enabled: false

# Public IP probes fall back in order, with at most four HTTPS endpoints per
# address family. Empty lists use the built-in defaults. Mainland China users
# may put trusted self-hosted dual-stack echo endpoints first.
# public_ip_probe:
#   ipv4_urls:
#     - https://your-ipv4-endpoint.example
#   ipv6_urls:
#     - https://your-ipv6-endpoint.example

# Optional Linux host IPv4 default-route failover. Candidate values are stable
# VoHive device IDs, not runtime wwan interface names. The system DNS resolver
# must remain reachable through the selected cellular route.
# host_network_failover:
#   enabled: true
#   primary_interface: eth0
#   candidate_device_ids:
#     - modem-9
#     - modem-2
#   probe_interval_seconds: 5
#   probe_timeout_seconds: 8
#   failure_threshold: 3
#   recovery_threshold: 5
#   minimum_backup_seconds: 30
#   maximum_route_metric: 5
